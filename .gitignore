# =========================
# ФРОНТЕНД (Node.js / Vite / React)
# =========================
# Зависимости
node_modules/

# Папка с готовым билдом (создается при npm run build)
dist/
dist-ssr/
build/

# Логи пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# БЭКЕНД (Python)
# =========================
# Кэш байт-кода
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
venv/
.venv/
env/
.env_python/

# =========================
# БЕЗОПАСНОСТЬ (Ключи и пароли)
# =========================
# Файлы с переменными окружения (ВНИМАНИЕ: никогда не заливайте их в Git!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =========================
# РЕДАКТОРЫ КОДА И ОС
# =========================
# Настройки VS Code / WebStorm
.vscode/
.idea/

# Системные файлы macOS и Windows
.DS_Store
Thumbs.db